{
  "name": "Portfolio and Private Budgeting",
  "image": "budgeting-flutter:latest",
  "remoteUser": "builder",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "sh .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter",
        "dart.projectSearchDepth": 3,
        "dart.runPubGetOnPubspecChanges": "always"
      }
    }
  }
}
