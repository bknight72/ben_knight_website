# PUBLIC Flutter build values (not secrets)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
STRIPE_PUBLISHABLE_KEY=
STRIPE_ENABLED=false

# PRIVATE Edge Function configuration. Hosted Supabase injects URL/service key.
SUPABASE_ANON_KEY=your-legacy-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
ALLOWED_ORIGINS=https://budgeting.benknight.dev
STRIPE_MODE=test
STRIPE_LIVE_AUTHORIZED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WORKER_SECRET=replace-with-independent-high-entropy-secret

# PRIVATE administration/deployment, never supplied to Flutter builds
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
