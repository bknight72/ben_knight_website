# PUBLIC Flutter build values (not secrets)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
STRIPE_PUBLISHABLE_KEY=
STRIPE_ENABLED=false
# Production opt-in only: STRIPE_ENABLED=true plus matching pk_live_ publishable key.
# Keep empty while disabled. No sk_/rk_/whsec_ values in public builds or GitHub vars.

# PRIVATE Edge Function configuration. Hosted Supabase injects URL/service key.
# Backend STRIPE_ENABLED is a separate Supabase secret, initially false as above.
SUPABASE_ANON_KEY=your-legacy-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
ALLOWED_ORIGINS=https://budgeting.benknight.dev
STRIPE_MODE=test
STRIPE_LIVE_AUTHORIZED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Approved live setup: STRIPE_MODE=live, STRIPE_LIVE_AUTHORIZED=true;
# STRIPE_SECRET_KEY holds a least-privilege rk_live_ (or sk_live_) backend key.
# Store backend credentials only in Supabase/Vault, never GitHub build variables.
WORKER_SECRET=replace-with-independent-high-entropy-secret

# PRIVATE administration/deployment, never supplied to Flutter builds
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# Public GitHub repository release variables (separate from Stripe activation)
BUDGETING_DEPLOY_ENABLED=false
# Configure SUPABASE_PROJECT_REF, VERCEL_ORG_ID, VERCEL_PROJECT_ID,
# VERCEL_PROJECT_NAME and BUDGETING_PRODUCTION_URL in budgeting-production.
# SUPABASE_ACCESS_TOKEN and VERCEL_TOKEN belong only in protected deploy secrets.
